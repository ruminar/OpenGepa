<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OpenGepa</AssemblyName>
    <Version>0.5.2</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>../OpenGepa/Assets/OpenGepa.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../OpenGepa.Update/OpenGepa.Update.csproj" />
    <Compile Include="../OpenGepa/InstanceIdentity.cs" Link="Shared/InstanceIdentity.cs" />
    <EmbeddedResource Include="$(UpdateProfileFile)" LogicalName="OpenGepa.UpdateProfile.json" Condition="'$(UpdateProfileFile)' != ''" />
  </ItemGroup>
</Project>
