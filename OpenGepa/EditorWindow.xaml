<Window x:Class="OpenGepa.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:OpenGepa.Models" xmlns:local="clr-namespace:OpenGepa"
        Title="OpenGepa - 編集" Width="820" Height="650" MinWidth="700" MinHeight="500" AllowDrop="True" Drop="Window_Drop" StateChanged="Window_StateChanged">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:EditorRootNode}" ItemsSource="{Binding Children}"><TextBlock Text="root" FontWeight="SemiBold"/></HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" ItemsSource="{Binding Children}"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileItem}"><TextBlock Text="{Binding Name}"/></DataTemplate>
        <DataTemplate DataType="{x:Type models:DirectoryItem}"><TextBlock Text="{Binding Name}"/></DataTemplate>
        <DataTemplate DataType="{x:Type models:UrlItem}"><TextBlock Text="{Binding Name}"/></DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
            <Style.Triggers>
                <Trigger Property="local:TreeSelectionVisual.IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFCCE5FF"/>
                    <Setter Property="Foreground" Value="#FF101828"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <ComboBox x:Name="TabsCombo" Width="220" DisplayMemberPath="Name" SelectionChanged="TabsCombo_SelectionChanged"/>
            <Button Content="新規ランチャー" Margin="8,0,0,0" Click="NewTab_Click"/><Button Content="名前変更" Margin="6,0,0,0" Click="RenameTab_Click"/>
        </StackPanel>
        <Border BorderBrush="#FFD0D5DD" BorderThickness="1" CornerRadius="6"><TreeView x:Name="EditorTree" Padding="8" AllowDrop="True" PreviewKeyDown="EditorTree_PreviewKeyDown" PreviewMouseLeftButtonDown="EditorTree_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="EditorTree_PreviewMouseRightButtonDown" MouseMove="EditorTree_MouseMove" DragOver="EditorTree_DragOver" Drop="EditorTree_Drop"/></Border>
    </DockPanel>
</Window>
