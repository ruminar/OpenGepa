<Window x:Class="OpenGepa.EditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:OpenGepa.Models" xmlns:local="clr-namespace:OpenGepa"
        Title="OpenGepa - 編集" Width="820" Height="650" MinWidth="700" MinHeight="500" AllowDrop="True" Drop="Window_Drop" StateChanged="Window_StateChanged" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource ItemForegroundBrush}">
    <Window.Resources>
        <local:TreeRowWidthConverter x:Key="TreeRowWidthConverter"/>
        <local:NodeIconConverter x:Key="NodeIconConverter"/>
        <Style x:Key="GroupNodeBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}"/><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(local:TreeSelectionVisual.IsSelected)}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="BorderBrush" Value="#FF1976D2"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ItemNodeBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ItemBackgroundBrush}"/><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(local:TreeSelectionVisual.IsSelected)}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="BorderBrush" Value="#FF1976D2"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <HierarchicalDataTemplate DataType="{x:Type local:EditorRootNode}" ItemsSource="{Binding Children}"><Border Background="{DynamicResource PanelBackgroundBrush}" Padding="3"><TextBlock Text="root" FontWeight="SemiBold" Foreground="{DynamicResource TabForegroundBrush}"/></Border></HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" ItemsSource="{Binding Children}"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Style="{StaticResource GroupNodeBorder}"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,6,0"><TextBlock Text="▸" HorizontalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/></StackPanel></Border></HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileItem}"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Style="{StaticResource ItemNodeBorder}"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,6,0"><TextBlock Text="▤" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border></DataTemplate>
        <DataTemplate DataType="{x:Type models:DirectoryItem}"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Style="{StaticResource ItemNodeBorder}"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,6,0"><TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Target}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border></DataTemplate>
        <DataTemplate DataType="{x:Type models:UrlItem}"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Style="{StaticResource ItemNodeBorder}"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,6,0"><TextBlock Text="◎" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border></DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="local:TreeSelectionVisual.IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource SelectionForegroundBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="12" Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock x:Name="TabNameText" Width="220" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource ItemForegroundBrush}"/>
            <Button Content="名前変更" Margin="8,0,0,0" Click="RenameTab_Click"/>
        </StackPanel>
        <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"><AdornerDecorator><TreeView x:Name="EditorTree" Background="Transparent" Padding="8" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewKeyDown="EditorTree_PreviewKeyDown" PreviewMouseLeftButtonDown="EditorTree_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="EditorTree_PreviewMouseRightButtonDown" MouseMove="EditorTree_MouseMove" DragOver="EditorTree_DragOver" DragLeave="EditorTree_DragLeave" Drop="EditorTree_Drop"/></AdornerDecorator></Border>
    </DockPanel>
</Window>
