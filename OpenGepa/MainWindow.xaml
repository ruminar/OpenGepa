<Window x:Class="OpenGepa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenGepa"
        xmlns:models="clr-namespace:OpenGepa.Models"
        Title="OpenGepa" Width="480" Height="600" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource ItemForegroundBrush}"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <local:TreeRowWidthConverter x:Key="TreeRowWidthConverter"/>
        <local:NodeIconConverter x:Key="NodeIconConverter"/>
        <local:TabIconConverter x:Key="TabIconConverter"/>
        <Style x:Key="PinToggleStyle" TargetType="ToggleButton"><Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="PinBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinBorder" Property="Background" Value="{DynamicResource PinHoverBackgroundBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="PinBorder" Property="Background" Value="{DynamicResource PinCheckedBackgroundBrush}"/><Setter TargetName="PinBorder" Property="BorderBrush" Value="{DynamicResource PinCheckedBorderBrush}"/><Setter Property="Foreground" Value="{DynamicResource PinCheckedForegroundBrush}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="FontWeight" Value="Bold"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="PinBorder" Property="Background" Value="{DynamicResource PinCheckedHoverBackgroundBrush}"/></MultiTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ToggleButton"><Setter Property="Focusable" Value="False"/></Style>
        <Style x:Key="GroupNodeBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource GroupBackgroundBrush}"/><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="BorderBrush" Value="#FF1976D2"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ItemNodeBorder" TargetType="Border"><Setter Property="Background" Value="{DynamicResource ItemBackgroundBrush}"/><Setter Property="Padding" Value="3"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsMouseOver}" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}"/><Setter Property="BorderBrush" Value="#FF1976D2"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" ItemsSource="{Binding Children}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource GroupNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▸" HorizontalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/></StackPanel></Grid>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileItem}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource ItemNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▤" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:DirectoryItem}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource ItemNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Target}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:UrlItem}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource ItemNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="◎" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:StoreAppItem}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource ItemNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▤" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:PresetItem}">
            <Grid ClipToBounds="False"><Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=32}" Style="{StaticResource ItemNodeBorder}"/><StackPanel Margin="3" Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="⚙" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Margin="10,8,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchText" Height="26" VerticalContentAlignment="Center" Padding="6,0" TextChanged="SearchText_Changed" ToolTip="表示名で絞り込み"><TextBox.ContextMenu><ContextMenu><MenuItem Header="クリア" Click="ClearSearch_Click"/><Separator/><MenuItem Command="{x:Static ApplicationCommands.Cut}" Header="切り取り"/><MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="コピー"/><MenuItem Command="{x:Static ApplicationCommands.Paste}" Header="貼り付け"/></ContextMenu></TextBox.ContextMenu></TextBox>
            <ToggleButton x:Name="PinToggle" Grid.Column="1" Margin="8,0,0,0" Width="30" Content="📌" Style="{StaticResource PinToggleStyle}" Checked="PinToggle_Changed" Unchecked="PinToggle_Changed" ToolTip="ランチャーを固定表示"/>
        </Grid>
        <Border Grid.Row="1" Margin="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
        <TreeView x:Name="LauncherTree" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ItemForegroundBrush}" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Auto" AllowDrop="True"
                          PreviewMouseLeftButtonDown="LauncherTree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="LauncherTree_PreviewMouseLeftButtonUp" MouseMove="LauncherTree_MouseMove" DragOver="LauncherTree_DragOver" Drop="LauncherTree_Drop" MouseDoubleClick="LauncherTree_MouseDoubleClick" KeyDown="LauncherTree_KeyDown" PreviewMouseRightButtonDown="LauncherTree_PreviewMouseRightButtonDown"/>
                <TextBlock x:Name="EmptyText" Text="表示されているランチャーがありません。&#x0a;トレイの［設定］から表示してください。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <ListBox x:Name="TabsList" Grid.Row="1" Grid.Column="1" Margin="0,10,10,10" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TabForegroundBrush}" AllowDrop="True"
                 SelectionChanged="TabsList_SelectionChanged" PreviewMouseLeftButtonDown="TabsList_PreviewMouseLeftButtonDown" PreviewMouseRightButtonDown="TabsList_PreviewMouseRightButtonDown" MouseMove="TabsList_MouseMove" DragOver="TabsList_DragOver" Drop="TabsList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <Border Margin="0,0,0,6" CornerRadius="7" Background="{DynamicResource TabBackgroundBrush}">
                    <Grid Width="76" Height="76" HorizontalAlignment="Left" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock Text="▣" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TabForegroundBrush}"/>
                        <Image Source="{Binding ., Converter={StaticResource TabIconConverter}, ConverterParameter=152}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        <Border VerticalAlignment="Bottom" Background="{DynamicResource TabOverlayBackgroundBrush}" Padding="2,3"><TextBlock Text="{Binding Name}" TextAlignment="Left" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TabOverlayForegroundBrush}"/></Border>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
