<Window x:Class="OpenGepa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenGepa"
        xmlns:models="clr-namespace:OpenGepa.Models"
        Title="OpenGepa" Width="480" Height="600" ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow" ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <local:TreeRowWidthConverter x:Key="TreeRowWidthConverter"/>
        <Style x:Key="PinToggleStyle" TargetType="ToggleButton"><Setter Property="Background" Value="{DynamicResource TabBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource TabForegroundBrush}"/><Setter Property="FontWeight" Value="Normal"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#FF0B3D70"/><Setter Property="BorderBrush" Value="#FF062E57"/><Setter Property="BorderThickness" Value="2"/><Setter Property="FontWeight" Value="Bold"/></Trigger></Style.Triggers></Style>
        <Style x:Key="NodeSelectionBorder" TargetType="Border"><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#FF1976D2"/><Setter Property="BorderThickness" Value="2"/></DataTrigger></Style.Triggers></Style>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" ItemsSource="{Binding Children}">
            <Border Style="{StaticResource NodeSelectionBorder}" HorizontalAlignment="Stretch" Background="{DynamicResource GroupBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▸" HorizontalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/></StackPanel></Border>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileItem}">
            <Border Style="{StaticResource NodeSelectionBorder}" HorizontalAlignment="Stretch" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▤" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:DirectoryItem}">
            <Border Style="{StaticResource NodeSelectionBorder}" HorizontalAlignment="Stretch" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="📁" FontSize="13" HorizontalAlignment="Center"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Target}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:UrlItem}">
            <Border Style="{StaticResource NodeSelectionBorder}" HorizontalAlignment="Stretch" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="◎" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding ., Converter={StaticResource NodeIconConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <Grid Grid.ColumnSpan="2" Margin="10,8,10,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchText" Height="26" VerticalContentAlignment="Center" Padding="6,0" TextChanged="SearchText_Changed" ToolTip="表示名で絞り込み"><TextBox.ContextMenu><ContextMenu><MenuItem Header="クリア" Click="ClearSearch_Click"/><Separator/><MenuItem Command="{x:Static ApplicationCommands.Cut}" Header="切り取り"/><MenuItem Command="{x:Static ApplicationCommands.Copy}" Header="コピー"/><MenuItem Command="{x:Static ApplicationCommands.Paste}" Header="貼り付け"/></ContextMenu></TextBox.ContextMenu></TextBox>
            <ToggleButton x:Name="PinToggle" Grid.Column="1" Margin="8,0,0,0" Width="30" Content="📌" Style="{StaticResource PinToggleStyle}" Checked="PinToggle_Changed" Unchecked="PinToggle_Changed" ToolTip="ランチャーを固定表示"/>
        </Grid>
        <Border Grid.Row="1" Margin="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
        <TreeView x:Name="LauncherTree" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ItemForegroundBrush}" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonUp="LauncherTree_PreviewMouseLeftButtonUp" MouseDoubleClick="LauncherTree_MouseDoubleClick" KeyDown="LauncherTree_KeyDown" PreviewMouseRightButtonDown="LauncherTree_PreviewMouseRightButtonDown"/>
                <TextBlock x:Name="EmptyText" Text="表示されているランチャーがありません。&#x0a;トレイの［設定］から表示してください。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <ListBox x:Name="TabsList" Grid.Row="1" Grid.Column="1" Margin="0,10,10,10" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TabForegroundBrush}"
                 SelectionChanged="TabsList_SelectionChanged" PreviewMouseRightButtonDown="TabsList_PreviewMouseRightButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <Border Margin="0,0,0,6" CornerRadius="7" Background="{DynamicResource TabBackgroundBrush}">
                    <Grid Width="76" Height="76" HorizontalAlignment="Left" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock Text="▣" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TabForegroundBrush}"/>
                        <Image Source="{Binding ., Converter={StaticResource TabIconConverter}, ConverterParameter=152}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        <Border VerticalAlignment="Bottom" Background="#B3FFFFFF" Padding="2,3"><TextBlock Text="{Binding Name}" TextAlignment="Left" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TabForegroundBrush}"/></Border>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
