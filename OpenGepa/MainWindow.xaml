<Window x:Class="OpenGepa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OpenGepa"
        xmlns:models="clr-namespace:OpenGepa.Models"
        Title="OpenGepa" Width="480" Height="600" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <Window.Resources>
        <local:TreeRowWidthConverter x:Key="TreeRowWidthConverter"/>
        <Style TargetType="TreeViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type models:GroupNode}" ItemsSource="{Binding Children}">
            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Background="{DynamicResource GroupBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▸" HorizontalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/><Image Source="{Binding Icon, Converter={StaticResource IconPathConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource GroupForegroundBrush}"/></StackPanel></Border>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type models:FileItem}">
            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▤" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding Icon, Converter={StaticResource IconPathConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:DirectoryItem}">
            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="▰" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding Icon, Converter={StaticResource IconPathConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type models:UrlItem}">
            <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TreeView}}, Converter={StaticResource TreeRowWidthConverter}, ConverterParameter=48}" Background="{DynamicResource ItemBackgroundBrush}" Padding="3" CornerRadius="3"><StackPanel Orientation="Horizontal"><Grid Width="20" Height="20" Margin="0,0,8,0"><TextBlock Text="◎" HorizontalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/><Image Source="{Binding Icon, Converter={StaticResource IconPathConverter}}"/></Grid><TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="{DynamicResource ItemForegroundBrush}"/></StackPanel></Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="88"/></Grid.ColumnDefinitions>
        <Border x:Name="FutureDashboardHeaderHost" Grid.ColumnSpan="2" Visibility="Collapsed"/>
        <Border Grid.Row="1" Margin="10" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
        <TreeView x:Name="LauncherTree" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ItemForegroundBrush}" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseLeftButtonUp="LauncherTree_MouseLeftButtonUp" KeyDown="LauncherTree_KeyDown"/>
                <TextBlock x:Name="EmptyText" Text="表示されているランチャーがありません。&#x0a;トレイの［設定］から表示してください。"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedForegroundBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <ListBox x:Name="TabsList" Grid.Row="1" Grid.Column="1" Margin="0,10,10,10" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TabForegroundBrush}"
                 SelectionChanged="TabsList_SelectionChanged" PreviewMouseRightButtonDown="TabsList_PreviewMouseRightButtonDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <Border Margin="0,0,0,6" CornerRadius="7" Background="{DynamicResource TabBackgroundBrush}">
                    <Grid Width="76" Height="76" HorizontalAlignment="Left" SnapsToDevicePixels="True" UseLayoutRounding="True">
                        <TextBlock Text="▣" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TabForegroundBrush}"/>
                        <Image Source="{Binding Icon, Converter={StaticResource IconPathConverter}, ConverterParameter=152}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True"/>
                        <Border VerticalAlignment="Bottom" Background="#B3FFFFFF" Padding="2,3"><TextBlock Text="{Binding Name}" TextAlignment="Left" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TabForegroundBrush}"/></Border>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
