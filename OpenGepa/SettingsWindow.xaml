<Window x:Class="OpenGepa.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenGepa - 設定" Width="600" Height="790" StateChanged="Window_StateChanged">
    <DockPanel Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <CheckBox x:Name="StartupCheck" DockPanel.Dock="Top" Content="Windows起動時にOpenGepaを起動する" Margin="0,0,0,16" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" Foreground="{DynamicResource ItemForegroundBrush}"/>
        <StackPanel>
            <GroupBox Header="外観" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,0,0,12">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="テーマ" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Content="ライト" Tag="light"/><ComboBoxItem Content="ダーク" Tag="dark"/><ComboBoxItem Content="カスタム" Tag="custom"/></ComboBox>
                    <TextBlock Grid.Row="1" Text="Group背景色" Margin="0,10,0,0" VerticalAlignment="Center"/><TextBox x:Name="GroupBackgroundText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="Group文字色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="GroupForegroundText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Text="項目背景色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="ItemBackgroundText" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Text="項目文字色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="ItemForegroundText" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"/>
                    <StackPanel x:Name="CustomAppearancePanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0"><TextBlock Text="カスタムでは#RRGGBB形式で指定します。" Foreground="{DynamicResource MutedForegroundBrush}"/><Button Content="配色を保存" Width="100" HorizontalAlignment="Right" Margin="0,6,0,0" Click="ApplyAppearance_Click"/></StackPanel>
                </Grid>
            </GroupBox>
            <GroupBox Header="既定アイコン" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,0,0,12"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Group" VerticalAlignment="Center"/><TextBlock x:Name="GroupIconPath" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="変更" Tag="group" Click="DefaultIcon_Click"/>
                <TextBlock Grid.Row="1" Text="DirectoryItem" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="DirectoryIconPath" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="directory" Click="DefaultIcon_Click"/>
                <TextBlock Grid.Row="2" Text="URLItem" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="UrlIconPath" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="url" Click="DefaultIcon_Click"/>
                <TextBlock Grid.Row="3" Text="タスクトレイ" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="TrayIconPath" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="3" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="tray" Click="DefaultIcon_Click"/>
            </Grid></GroupBox>
            <GroupBox Header="縦タブの表示と順序" Foreground="{DynamicResource ItemForegroundBrush}"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Right"><Button x:Name="UpButton" Content="上へ" Width="70" Click="Up_Click"/><Button x:Name="DownButton" Content="下へ" Width="70" Margin="0,6,0,0" Click="Down_Click"/></StackPanel><ListBox x:Name="TabsList" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource ItemForegroundBrush}" SelectionChanged="TabsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Click="Visibility_Click"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
            <GroupBox Header="設定の保存と読み込み" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Margin="10"><Button Content="Profileを保存" Click="Save_Click"/><Button Content="Profileを読み込む" Margin="8,0,0,0" Click="Load_Click"/></StackPanel></GroupBox>
            <Button Content="OK" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </DockPanel>
</Window>
