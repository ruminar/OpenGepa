<Window x:Class="OpenGepa.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenGepa - 設定" Width="600" Height="500" StateChanged="Window_StateChanged">
    <DockPanel Margin="16">
        <CheckBox x:Name="StartupCheck" DockPanel.Dock="Top" Content="Windows起動時にOpenGepaを起動する" Margin="0,0,0,16" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Profileを保存" Click="Save_Click"/><Button Content="Profileを読み込む" Margin="8,0,0,0" Click="Load_Click"/></StackPanel>
        <GroupBox Header="縦タブの表示と順序"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Right"><Button Content="上へ" Width="70" Click="Up_Click"/><Button Content="下へ" Width="70" Margin="0,6,0,0" Click="Down_Click"/></StackPanel><ListBox x:Name="TabsList"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Click="Visibility_Click"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
    </DockPanel>
</Window>
