<Window x:Class="OpenGepa.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="OpenGepa - 設定" Width="680" Height="760" StateChanged="Window_StateChanged" Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource ItemForegroundBrush}">
    <DockPanel Margin="16" Background="{DynamicResource AppBackgroundBrush}">
        <Button DockPanel.Dock="Bottom" Content="OK" Width="90" HorizontalAlignment="Right" Margin="0,16,0,0" IsDefault="True" Click="Ok_Click"/>
        <TabControl>
            <TabItem Header="一般"><StackPanel Margin="14"><CheckBox x:Name="StartupCheck" Content="Windows起動時にOpenGepaを起動する" Checked="StartupCheck_Changed" Unchecked="StartupCheck_Changed" Foreground="{DynamicResource ItemForegroundBrush}"/><TextBlock Margin="0,14,0,0" Text="ランチャーの検索語とGroupの展開状態は、OpenGepaの実行中だけ保持します。再起動後はすべて折りたたんだ状態です。" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"/></StackPanel></TabItem>
            <TabItem Header="ランチャー"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                <GroupBox Header="項目の起動操作" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,0,0,12"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="FileItem" VerticalAlignment="Center"/><ComboBox x:Name="FileItemClickCombo" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ItemClickCombo_SelectionChanged"><ComboBoxItem Content="シングルクリックで起動" Tag="1"/><ComboBoxItem Content="ダブルクリックで起動" Tag="2"/></ComboBox>
                    <TextBlock Grid.Row="1" Text="DirectoryItem" Margin="0,6,0,0" VerticalAlignment="Center"/><ComboBox x:Name="DirectoryItemClickCombo" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" SelectedValuePath="Tag" SelectionChanged="ItemClickCombo_SelectionChanged"><ComboBoxItem Content="シングルクリックで開く" Tag="1"/><ComboBoxItem Content="ダブルクリックで開く" Tag="2"/></ComboBox>
                    <TextBlock Grid.Row="2" Text="URLItem" Margin="0,6,0,0" VerticalAlignment="Center"/><ComboBox x:Name="UrlItemClickCombo" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" SelectedValuePath="Tag" SelectionChanged="ItemClickCombo_SelectionChanged"><ComboBoxItem Content="シングルクリックで開く" Tag="1"/><ComboBoxItem Content="ダブルクリックで開く" Tag="2"/></ComboBox>
                </Grid></GroupBox>
                <GroupBox Header="ランチャータブの表示と順序" Foreground="{DynamicResource ItemForegroundBrush}"><DockPanel Margin="8"><StackPanel DockPanel.Dock="Right"><Button x:Name="UpButton" Content="上へ" Width="70" Click="Up_Click"/><Button x:Name="DownButton" Content="下へ" Width="70" Margin="0,6,0,0" Click="Down_Click"/></StackPanel><ListBox x:Name="TabsList" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource ItemForegroundBrush}" SelectionChanged="TabsList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Click="Visibility_Click"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="外観とアイコン"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                <GroupBox Header="外観" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,0,0,12"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="テーマ" VerticalAlignment="Center"/><ComboBox x:Name="ThemeCombo" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ThemeCombo_SelectionChanged"><ComboBoxItem Content="ライト" Tag="light"/><ComboBoxItem Content="ダーク" Tag="dark"/><ComboBoxItem Content="カスタム" Tag="custom"/></ComboBox>
                    <TextBlock Grid.Row="1" Text="Group背景色" Margin="0,10,0,0" VerticalAlignment="Center"/><TextBox x:Name="GroupBackgroundText" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"/>
                    <TextBlock Grid.Row="2" Text="Group文字色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="GroupForegroundText" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="3" Text="項目背景色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="ItemBackgroundText" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0"/>
                    <TextBlock Grid.Row="4" Text="項目文字色" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBox x:Name="ItemForegroundText" Grid.Row="4" Grid.Column="1" Margin="0,6,0,0"/>
                    <StackPanel x:Name="CustomAppearancePanel" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,0"><TextBlock Text="カスタムでは#RRGGBB形式で指定します。" Foreground="{DynamicResource MutedForegroundBrush}"/><Button Content="配色を保存" Width="100" HorizontalAlignment="Right" Margin="0,6,0,0" Click="ApplyAppearance_Click"/></StackPanel>
                </Grid></GroupBox>
                <GroupBox Header="既定アイコン" Foreground="{DynamicResource ItemForegroundBrush}"><Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="60"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Group" VerticalAlignment="Center"/><TextBlock x:Name="GroupIconPath" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Column="2" Content="変更" Tag="group" Click="DefaultIcon_Click"/><Button x:Name="GroupIconDelete" Grid.Column="3" Content="削除" Tag="group" Click="DefaultIcon_Delete"/>
                    <TextBlock Grid.Row="1" Text="DirectoryItem" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="DirectoryIconPath" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="1" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="directory" Click="DefaultIcon_Click"/><Button x:Name="DirectoryIconDelete" Grid.Row="1" Grid.Column="3" Margin="0,6,0,0" Content="削除" Tag="directory" Click="DefaultIcon_Delete"/>
                    <TextBlock Grid.Row="2" Text="URLItem" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="UrlIconPath" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="2" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="url" Click="DefaultIcon_Click"/><Button x:Name="UrlIconDelete" Grid.Row="2" Grid.Column="3" Margin="0,6,0,0" Content="削除" Tag="url" Click="DefaultIcon_Delete"/>
                    <TextBlock Grid.Row="3" Text="タスクトレイ" Margin="0,6,0,0" VerticalAlignment="Center"/><TextBlock x:Name="TrayIconPath" Grid.Row="3" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><Button Grid.Row="3" Grid.Column="2" Margin="0,6,0,0" Content="変更" Tag="tray" Click="DefaultIcon_Click"/><Button x:Name="TrayIconDelete" Grid.Row="3" Grid.Column="3" Margin="0,6,0,0" Content="削除" Tag="tray" Click="DefaultIcon_Delete"/>
                </Grid></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="Windows機能"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
                <GroupBox Header="Windows Menu" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,0,0,12"><StackPanel Margin="10"><TextBlock Text="Start Menuは現在のユーザー用と全ユーザー用を読み直して表示します。全ユーザー用の操作は確認後にUACを求めます。" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"/><CheckBox x:Name="WindowsMenuCurrentEditCheck" Margin="0,10,0,0" Content="現在のユーザー用 Start Menu の作成・削除・名前変更を許可する" Checked="WindowsMenuEdit_Changed" Unchecked="WindowsMenuEdit_Changed"/><CheckBox x:Name="WindowsMenuAllUsersEditCheck" Margin="0,6,0,0" Content="全ユーザー用 Start Menu の作成・削除・名前変更を許可する（UAC）" Checked="WindowsMenuEdit_Changed" Unchecked="WindowsMenuEdit_Changed"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBlock Text="同じ階層内の優先順:" VerticalAlignment="Center" Margin="0,0,10,0"/><RadioButton x:Name="FoldersFirstRadio" Content="フォルダを上" Checked="WindowsMenuSort_Changed"/><RadioButton x:Name="ShortcutsFirstRadio" Content="ショートカットを上" Margin="12,0,0,0" Checked="WindowsMenuSort_Changed"/></StackPanel></StackPanel></GroupBox>
                <GroupBox Header="主要操作プリセット" Foreground="{DynamicResource ItemForegroundBrush}"><DockPanel Margin="10"><Button DockPanel.Dock="Bottom" Content="すべて表示へ戻す" Width="130" HorizontalAlignment="Right" Margin="0,10,0,0" Click="RestorePresets_Click"/><ListBox x:Name="PresetItemsList" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsVisible}" Click="PresetVisibility_Click"/></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></GroupBox>
            </StackPanel></ScrollViewer></TabItem>
            <TabItem Header="データ"><StackPanel Margin="14"><TextBlock Text="Profileにはアプリランチャー、Webランチャー、アイコン、およびOpenGepa管理のショートカットだけを含めます。Windows Menu、ストアアプリ、主要操作プリセットは移しません。" TextWrapping="Wrap" Foreground="{DynamicResource MutedForegroundBrush}"/><GroupBox Header="設定の保存と読み込み" Foreground="{DynamicResource ItemForegroundBrush}" Margin="0,14,0,0"><StackPanel Orientation="Horizontal" Margin="10"><Button Content="Profileを保存" Click="Save_Click"/><Button Content="Profileを読み込む" Margin="8,0,0,0" Click="Load_Click"/></StackPanel></GroupBox></StackPanel></TabItem>
        </TabControl>
    </DockPanel>
</Window>
